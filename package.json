{
  "name": "twintrack-master",
  "version": "1.4.0",
  "private": true,
  "description": "TwinTrack Master module: login, users, permissions and the API behind every module.",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w @twintrack/master-backend",
    "dev:frontend": "npm run dev -w @twintrack/master-frontend",
    "seed": "npm run seed -w @twintrack/master-backend",
    "seed:modules": "npm run seed:modules -w @twintrack/master-backend",
    "build": "npm run build -w @twintrack/master-backend && npm run build -w @twintrack/master-frontend",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @twintrack/master-backend",
    "test:postman": "npm run test:postman -w @twintrack/master-backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
