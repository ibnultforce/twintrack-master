{
  "manifestVersion": 1,
  "module": {
    "key": "master",
    "name": "Master",
    "version": "1.3.0",
    "description": "Login, users, roles. Signs every token.",
    "repository": "twintrack-master",
    "baseUrl": "/api",
    "core": true
  },
  "resources": [
    {
      "key": "user",
      "label": "Users",
      "actions": [
        "read",
        "create",
        "update",
        "delete"
      ]
    },
    {
      "key": "role",
      "label": "Roles",
      "actions": [
        "read",
        "update"
      ]
    },
    {
      "key": "module",
      "label": "Modules",
      "actions": [
        "read",
        "create",
        "delete"
      ]
    },
    {
      "key": "audit",
      "label": "Activity log",
      "actions": [
        "read"
      ]
    },
    {
      "key": "employeeAccess",
      "label": "Employee app access",
      "actions": [
        "read",
        "update"
      ]
    },
    {
      "key": "fieldAccess",
      "label": "Field access",
      "actions": [
        "read",
        "update"
      ]
    }
  ],
  "routes": [
    {
      "method": "POST",
      "path": "/auth/login",
      "access": "public"
    },
    {
      "method": "POST",
      "path": "/auth/refresh",
      "access": "public"
    },
    {
      "method": "GET",
      "path": "/.well-known/jwks.json",
      "access": "public"
    },
    {
      "method": "GET",
      "path": "/auth/me",
      "access": "signed"
    },
    {
      "method": "POST",
      "path": "/auth/logout",
      "access": "signed"
    },
    {
      "method": "GET",
      "path": "/users",
      "access": "private",
      "permission": "user.read"
    },
    {
      "method": "PATCH",
      "path": "/users/:id/roles",
      "access": "private",
      "permission": "user.update"
    },
    {
      "method": "POST",
      "path": "/modules/import",
      "access": "private",
      "permission": "module.create"
    },
    {
      "method": "GET",
      "path": "/audit",
      "access": "private",
      "permission": "audit.read"
    },
    {
      "method": "GET",
      "path": "/modules/employee/access",
      "access": "private",
      "permission": "employeeAccess.read"
    },
    {
      "method": "GET",
      "path": "/modules/employee/history",
      "access": "private",
      "permission": "employeeAccess.read"
    },
    {
      "method": "PUT",
      "path": "/modules/employee/rules",
      "access": "private",
      "permission": "employeeAccess.update"
    },
    {
      "method": "PUT",
      "path": "/modules/employee/overrides/:id",
      "access": "private",
      "permission": "employeeAccess.update"
    },
    {
      "method": "PUT",
      "path": "/modules/employee/privileges/:id",
      "access": "private",
      "permission": "employeeAccess.update"
    },
    {
      "method": "GET",
      "path": "/modules/fields",
      "access": "private",
      "permission": "fieldAccess.read"
    },
    {
      "method": "PUT",
      "path": "/modules/:key/fields",
      "access": "private",
      "permission": "fieldAccess.update"
    }
  ],
  "roles": [
    {
      "key": "admin",
      "name": "Access Admin",
      "description": "Manages people, roles and modules.",
      "grants": "*"
    },
    {
      "key": "employee-access",
      "name": "Employee access manager",
      "description": "From the HR panel: sets who has which Employee app role, gives special privileges, and manages access to fields the modules mark as HR-managed. Cannot change collection permissions, or fields a module keeps fixed.",
      "grants": {
        "employeeAccess": {
          "actions": [
            "read",
            "update"
          ]
        },
        "fieldAccess": {
          "actions": [
            "read",
            "update"
          ]
        },
        "user": {
          "actions": [
            "read"
          ]
        }
      }
    },
    {
      "key": "auditor",
      "name": "Auditor",
      "description": "Reads the activity log and who has Employee app access.",
      "grants": {
        "audit": {
          "actions": [
            "read"
          ]
        },
        "user": {
          "actions": [
            "read"
          ]
        },
        "employeeAccess": {
          "actions": [
            "read"
          ]
        },
        "fieldAccess": {
          "actions": [
            "read"
          ]
        }
      }
    }
  ]
}
