{
  "manifestVersion": 1,
  "module": {
    "key": "master",
    "name": "Master",
    "version": "1.4.0",
    "description": "Login, users, permissions and the API behind every module.",
    "repository": "twintrack-master",
    "baseUrl": "/",
    "core": true
  },
  "resources": [
    { "key": "user", "label": "Users", "actions": ["read", "create", "update", "delete"] },
    { "key": "role", "label": "Roles", "actions": ["read", "update"] },
    { "key": "module", "label": "Modules", "actions": ["read", "create", "delete"] },
    { "key": "audit", "label": "Activity log", "actions": ["read"] },
    { "key": "hrAccess", "label": "HR access", "actions": ["read", "update"] },
    { "key": "employeeAccess", "label": "Employee app access", "actions": ["read", "update"] },
    { "key": "fieldAccess", "label": "Field access", "actions": ["read", "update"] }
  ],
  "routes": [
    { "method": "GET", "path": "/health", "access": "public" },
    { "method": "POST", "path": "/auth/login", "access": "public", "planned": true },
    { "method": "POST", "path": "/auth/refresh", "access": "public", "planned": true },
    { "method": "POST", "path": "/auth/logout", "access": "signed", "planned": true },
    { "method": "GET", "path": "/auth/me", "access": "signed", "planned": true },
    { "method": "PATCH", "path": "/auth/me", "access": "signed", "planned": true },
    { "method": "POST", "path": "/auth/change-password", "access": "signed", "planned": true },
    { "method": "GET", "path": "/me/modules", "access": "signed", "planned": true },
    { "method": "GET", "path": "/me/permissions/:module", "access": "signed", "planned": true },
    { "method": "GET", "path": "/users", "access": "private", "permission": "user.read", "planned": true },
    { "method": "POST", "path": "/users", "access": "private", "permission": "user.create", "planned": true },
    { "method": "GET", "path": "/users/access-options", "access": "private", "permission": "user.read", "planned": true },
    { "method": "GET", "path": "/users/:id", "access": "private", "permission": "user.read", "planned": true },
    { "method": "PATCH", "path": "/users/:id", "access": "private", "permission": "user.update", "planned": true },
    { "method": "PATCH", "path": "/users/:id/status", "access": "private", "permission": "user.update", "planned": true },
    { "method": "POST", "path": "/users/:id/reset-password", "access": "private", "permission": "user.update", "planned": true },
    { "method": "PATCH", "path": "/users/:id/roles", "access": "private", "anyPermission": ["user.update", "hrAccess.update"], "planned": true },
    { "method": "PUT", "path": "/users/:id/privileges", "access": "private", "anyPermission": ["user.update", "hrAccess.update"], "planned": true },
    { "method": "GET", "path": "/modules", "access": "private", "permission": "module.read", "planned": true },
    { "method": "POST", "path": "/modules/import", "access": "private", "permission": "module.create", "planned": true },
    { "method": "DELETE", "path": "/modules/:key", "access": "private", "permission": "module.delete", "planned": true },
    { "method": "GET", "path": "/roles", "access": "private", "permission": "role.read", "planned": true },
    { "method": "GET", "path": "/audit", "access": "private", "permission": "audit.read", "planned": true },
    { "method": "GET", "path": "/modules/employee/access", "access": "private", "permission": "employeeAccess.read", "planned": true },
    { "method": "GET", "path": "/modules/employee/history", "access": "private", "permission": "employeeAccess.read", "planned": true },
    { "method": "PUT", "path": "/modules/employee/rules", "access": "private", "permission": "employeeAccess.update", "planned": true },
    { "method": "PUT", "path": "/modules/employee/overrides/:id", "access": "private", "permission": "employeeAccess.update", "planned": true },
    { "method": "PUT", "path": "/modules/employee/privileges/:id", "access": "private", "permission": "employeeAccess.update", "planned": true },
    { "method": "GET", "path": "/modules/fields", "access": "private", "permission": "fieldAccess.read", "planned": true },
    { "method": "PUT", "path": "/modules/:key/fields", "access": "private", "permission": "fieldAccess.update", "planned": true }
  ],
  "roles": [
    {
      "key": "admin",
      "name": "Access Admin",
      "description": "Manages people, roles and modules.",
      "grants": "*"
    },
    {
      "key": "hr-access",
      "name": "HR access manager",
      "description": "HR staff who set each person's HR role and special privileges, and manage Employee app and field access from the HR panel. Cannot change role templates.",
      "grants": {
        "user": { "actions": ["read"] },
        "hrAccess": { "actions": ["read", "update"] },
        "employeeAccess": { "actions": ["read", "update"] },
        "fieldAccess": { "actions": ["read", "update"] }
      }
    },
    {
      "key": "employee-access",
      "name": "Employee access manager",
      "description": "From the HR panel: sets who has which Employee app role, gives special privileges, and manages access to fields the modules mark as HR-managed. Cannot change collection permissions, or fields a module keeps fixed.",
      "grants": {
        "user": { "actions": ["read"] },
        "employeeAccess": { "actions": ["read", "update"] },
        "fieldAccess": { "actions": ["read", "update"] }
      }
    },
    {
      "key": "auditor",
      "name": "Auditor",
      "description": "Reads the activity log and who has Employee app access.",
      "grants": {
        "audit": { "actions": ["read"] },
        "user": { "actions": ["read"] },
        "hrAccess": { "actions": ["read"] },
        "employeeAccess": { "actions": ["read"] },
        "fieldAccess": { "actions": ["read"] }
      }
    }
  ]
}
