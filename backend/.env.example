# Copy to .env for local development.
PORT=4100
MONGODB_URI=mongodb://127.0.0.1:27017/twintrack?replicaSet=rs0
# Comma-separated frontends allowed to call this API.
ALLOWED_ORIGINS=http://twintrack.localhost:3100,http://hr.twintrack.localhost:3200
# Where each module's frontend lives, as module=address. Each address must also be in ALLOWED_ORIGINS.
MODULE_FRONTEND_URLS=master=http://twintrack.localhost:3100,hr=http://hr.twintrack.localhost:3200
LOG_LEVEL=info
# How many proxies or load balancers sit in front of the API. Rate limits need this to see each caller's real address.
TRUST_PROXY_HOPS=0

# Signs access tokens. Required, at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Identifies this API inside its tokens.
JWT_ISSUER=https://api.twintrack.com
ACCESS_TOKEN_TTL_SECONDS=900
# A session ends after SESSION_IDLE_DAYS without use, and after SESSION_MAX_DAYS regardless.
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30
# How long a just-replaced refresh token still works, so two tabs refreshing together don't end the session.
REFRESH_GRACE_SECONDS=10
# Sends the refresh cookie over HTTPS only. Defaults to true in production, where false is refused.
REFRESH_COOKIE_SECURE=false
# Failed logins allowed from one address in each window.
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_RATE_WINDOW_MINUTES=15

# Required by `npm run seed`, as the password for new users. Development only: the seed refuses to run in production.
SEED_PASSWORD=demo1234
