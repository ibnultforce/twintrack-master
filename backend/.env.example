# Copy to .env for local development.
PORT=4100
MONGODB_URI=mongodb://127.0.0.1:27017/twintrack?replicaSet=rs0
# Comma-separated frontends allowed to call this API.
ALLOWED_ORIGINS=http://twintrack.localhost:3100,http://hr.twintrack.localhost:3200,http://tasks.twintrack.localhost:3300
# Where each module's frontend lives, as module=address. Each address must also be in ALLOWED_ORIGINS.
MODULE_FRONTEND_URLS=master=http://twintrack.localhost:3100,hr=http://hr.twintrack.localhost:3200,tasks=http://tasks.twintrack.localhost:3300
LOG_LEVEL=info
# How many proxies or load balancers sit in front of the API. Rate limits need this to see each caller's real address.
TRUST_PROXY_HOPS=0

# Signs access tokens. Required, at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Identifies this API inside its tokens.
JWT_ISSUER=https://api.twintrack.com
ACCESS_TOKEN_TTL_SECONDS=900
# A session ends after SESSION_IDLE_DAYS without use, and after SESSION_MAX_DAYS regardless.
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30
# How long a just-replaced refresh token still works, so two tabs refreshing together don't end the session.
REFRESH_GRACE_SECONDS=10
# Sends the refresh cookie over HTTPS only. Defaults to true in production, where false is refused.
REFRESH_COOKIE_SECURE=false
# Failed logins allowed from one address in each window.
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_RATE_WINDOW_MINUTES=15

# Required by `npm run seed`, as the password for new users. Development only: the seed refuses to run in production.
SEED_PASSWORD=demo1234

# Serves a page at /try for testing the API from a browser. Development only: production refuses to start with it on.
TEST_PAGE_ENABLED=true

# Emails, such as set-password links, are sent through Resend. Required in production. Without it, emails go to the log.
RESEND_API_KEY=
EMAIL_FROM=TwinTrack <no-reply@twintrack.com>
# The portal address that links in emails open. Defaults to master in MODULE_FRONTEND_URLS. Required in production.
PORTAL_URL=http://twintrack.localhost:3100
PASSWORD_LINK_TTL_HOURS=24

# This API's own public address, named to apps connecting over OAuth and MCP. Required in production, as https.
PUBLIC_API_URL=http://api.twintrack.localhost:4100
# Encrypts secrets that must be read back, such as OAuth client secrets. 64 hex characters. Required in production.
# Losing it makes those secrets unreadable. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Lets a super admin "Log in as" someone from their People page. Development only: production refuses to start with it on.
IMPERSONATION_ENABLED=true
