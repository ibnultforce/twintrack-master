# Copy to .env for local development.
PORT=4100
MONGODB_URI=mongodb://127.0.0.1:27017/twintrack?replicaSet=rs0
# Comma-separated frontends allowed to call this API.
ALLOWED_ORIGINS=http://twintrack.localhost:3100
LOG_LEVEL=info
# Password for new users created by `npm run seed`. Development only: the seed refuses to run in production.
SEED_PASSWORD=demo1234
