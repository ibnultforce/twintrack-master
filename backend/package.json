{
  "name": "@twintrack/master-backend",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "seed": "tsx --env-file-if-exists=.env src/seed/run.ts",
    "seed:modules": "tsx --env-file-if-exists=.env src/seed/runSyncModules.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postman": "tsx --env-file-if-exists=.env tests/run-postman.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "mongoose": "^9.12.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/newman": "^5.3.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "newman": "^6.2.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
