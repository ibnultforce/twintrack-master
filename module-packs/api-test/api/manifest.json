{
  "manifestVersion": 1,
  "module": {
    "key": "api-test",
    "name": "API Test",
    "version": "1.0.0",
    "description": "A one-route module for checking that a module's routes and permissions work end to end.",
    "repository": "twintrack-api-test",
    "baseUrl": "/api-test"
  },
  "resources": [
    {
      "key": "test",
      "label": "Test",
      "actions": [
        "read"
      ]
    }
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/test",
      "access": "private",
      "permission": "test.read"
    }
  ]
}
