{
  "manifestVersion": 1,
  "module": {
    "key": "projects",
    "name": "Project management",
    "version": "2.0.0",
    "description": "Projects, their members, and tasks from start through QA to approval.",
    "repository": "twintrack-projects",
    "baseUrl": "/projects"
  },
  "resources": [
    {
      "key": "project",
      "label": "Projects",
      "actions": [
        "read",
        "create",
        "update"
      ],
      "scoped": true,
      "trackedFields": [
        "name",
        "status",
        "deadline",
        "leadId",
        "memberIds",
        "totalAllocatedHours",
        "clientId"
      ],
      "recordFields": [
        "name",
        "description",
        "status",
        "totalAllocatedHours",
        "deadline",
        "clientId"
      ],
      "sharingModel": "private"
    },
    {
      "key": "task",
      "label": "Tasks",
      "actions": [
        "read",
        "create",
        "update",
        "approve",
        "delete"
      ],
      "scoped": true,
      "trackedFields": [
        "title",
        "status",
        "estimatedHours",
        "dueDate",
        "assignedDevId",
        "tlId",
        "qaId",
        "qaEstimatedHours",
        "approvedHours",
        "qaApprovedHours",
        "qaResult",
        "billable",
        "flagged",
        "flagNote",
        "actualHours",
        "pointValue",
        "kind"
      ],
      "recordFields": [
        "title",
        "description",
        "dueDate",
        "estimatedHours",
        "actualHours",
        "approvedHours",
        "qaEstimatedHours",
        "qaActualHours",
        "qaApprovedHours",
        "qaResult",
        "kind",
        "billable",
        "flagged",
        "flagNote",
        "pointValue",
        "qaPointValue"
      ],
      "sharingModel": "private",
      "protectedFields": [
        "qaEstimatedHours",
        "qaActualHours",
        "qaApprovedHours",
        "qaPointValue"
      ]
    },
    {
      "key": "points",
      "label": "Career points",
      "actions": [
        "read"
      ],
      "scoped": true
    },
    {
      "key": "credential",
      "label": "Project logins",
      "actions": [
        "read",
        "create",
        "update",
        "delete"
      ],
      "scoped": true,
      "trackedFields": [
        "label",
        "loginUrl",
        "username",
        "notes"
      ],
      "recordFields": [
        "label",
        "loginUrl",
        "username",
        "password",
        "passcode",
        "otpCode",
        "notes"
      ],
      "sharingModel": "private"
    },
    {
      "key": "incentive",
      "label": "Incentives",
      "actions": [
        "read",
        "create",
        "update"
      ],
      "scoped": true
    }
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/projects",
      "access": "private",
      "permission": "project.read"
    },
    {
