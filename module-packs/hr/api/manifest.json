{
  "manifestVersion": 1,
  "module": {
    "key": "hr",
    "name": "HR",
    "version": "1.11.0",
    "description": "Employee records, leave, attendance and hiring.",
    "repository": "twintrack-hr",
    "baseUrl": "/hr"
  },
  "resources": [
    {
      "key": "salary",
      "label": "Salaries",
      "actions": [
        "read",
        "create",
        "update",
        "approve",
        "delete",
        "share"
      ],
      "scoped": true,
      "trackedFields": [
        "amount",
        "currency",
        "effectiveFrom",
        "status"
      ],
      "recordFields": [
        "amount",
        "currency",
        "effectiveFrom",
        "status"
      ],
      "sharingModel": "private",
      "protectedFields": [
        "amount"
      ]
    }
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/salaries",
      "access": "private",
      "permission": "salary.read"
    },
    {
      "method": "POST",
      "path": "/salaries",
      "access": "private",
      "permission": "salary.create"
    },
    {
      "method": "PATCH",
      "path": "/salaries/:id",
      "access": "private",
      "permission": "salary.update"
    },
    {
      "method": "PATCH",
      "path": "/salaries/:id/approve",
      "access": "private",
      "permission": "salary.approve"
    },
    {
      "method": "DELETE",
      "path": "/salaries/:id",
      "access": "private",
      "permission": "salary.delete"
    },
    {
      "method": "POST",
      "path": "/salaries/:id/restore",
      "access": "private",
      "permission": "salary.delete"
    },
    {
      "method": "GET",
      "path": "/salaries/:id/history",
      "access": "private",
      "permission": "salary.read"
    },
    {
      "method": "GET",
      "path": "/salaries/:id/shares",
      "access": "private",
      "permission": "salary.read"
    },
    {
      "method": "POST",
      "path": "/salaries/:id/shares",
      "access": "private",
      "permission": "salary.read"
    },
    {
      "method": "DELETE",
      "path": "/salaries/:id/shares/:shareId",
      "access": "private",
      "permission": "salary.read"
    }
  ]
}
