          "name": "Approving needs a token",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hr/salaries/{{salaryId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
