  "item": [
    {
      "name": "HR",
      "description": "Run this folder in order. Salaries and module admins, with permissions and reach coming from each person's role. It creates one salary and approves another, so a re-run on a dev server changes that data.",
      "item": [
        {
          "name": "Sign in as the HR Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{webOrigin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{hrAdminEmail}}\",\"password\":\"{{password}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('hrAdminToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in as an HR Manager",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{webOrigin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('noRoleToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in as HR Staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{webOrigin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{hrManagerEmail}}\",\"password\":\"{{password}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('hrManagerToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "HR Admin lists every salary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hrAdminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/hr/salaries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hr",
                "salaries"
              ]
            },
            "description": "Needs salary.read. How far it reaches comes from the permission set: own, team or all."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('reaches everyone', () => {",
                  "  pm.expect(pm.response.json().scope).to.eql('all');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HR Manager lists their team's salaries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{noRoleToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/hr/salaries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hr",
                "salaries"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('reaches their team', () => {",
                  "  pm.expect(pm.response.json().scope).to.eql('team');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HR Staff has no salary access",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hrManagerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/hr/salaries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hr",
                "salaries"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 403', () => pm.response.to.have.status(403));",
                  "pm.test('names the problem', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('forbidden');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Salaries need a token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hr/salaries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hr",
                "salaries"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 401', () => pm.response.to.have.status(401));",
                  "pm.test('names the problem', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('no_token');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HR Admin adds a salary",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hrAdminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"employeeId\":\"{{hrTeamMemberId}}\",\"amount\":99000,\"effectiveFrom\":\"2027-01-01\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/hr/salaries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hr",
                "salaries"
              ]
            },
            "description": "Needs salary.create. It starts as pending."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 201', () => pm.response.to.have.status(201));",
                  "pm.test('starts as pending', () => {",
                  "  pm.expect(pm.response.json().status).to.eql('pending');",
                  "  pm.collectionVariables.set('salaryId', pm.response.json().id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Adding a salary for nobody is refused",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hrAdminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"employeeId\":\"no-such-person\",\"amount\":1,\"effectiveFrom\":\"2027-01-01\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/hr/salaries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hr",
                "salaries"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 422', () => pm.response.to.have.status(422));",
                  "pm.test('names the problem', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('validation_failed');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HR Manager can not add a salary",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{noRoleToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"employeeId\":\"{{hrTeamMemberId}}\",\"amount\":1,\"effectiveFrom\":\"2027-01-01\"}"
