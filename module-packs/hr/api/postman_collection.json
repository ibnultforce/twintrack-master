                  "pm.test('names the problem', () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql('forbidden');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Adding a salary needs a token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hr/salaries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
