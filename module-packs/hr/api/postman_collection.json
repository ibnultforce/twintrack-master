                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HR Admin approves a salary",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hrAdminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/hr/salaries/{{salaryId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hr",
                "salaries",
                "{{salaryId}}",
                "approve"
              ]
            },
            "description": "Needs salary.approve."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('is approved', () => {",
                  "  pm.expect(pm.response.json().status).to.eql('approved');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HR Manager can not approve a salary",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{noRoleToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/hr/salaries/{{salaryId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
