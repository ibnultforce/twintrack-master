        {
          "name": "Changing an amount sends it back to pending",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hrAdminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"amount\":100000}"
            },
            "url": {
              "raw": "{{baseUrl}}/hr/salaries/{{salaryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hr",
                "salaries",
                "{{salaryId}}"
              ]
            },
            "description": "Needs salary.update."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('is pending again', () => {",
                  "  pm.expect(pm.response.json().status).to.eql('pending');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HR Manager can not change an amount",
