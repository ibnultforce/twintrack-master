{
  "info": {
    "name": "TwinTrack Demo API",
    "description": "Every route of the Master API, with tests. Run it in Postman against a running API, or with `npm run test:postman`, which starts its own copy. Update this file in the same change as any route.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "webOrigin",
      "value": ""
    },
    {
      "key": "demoToken",
      "value": ""
    },
    {
      "key": "demoNoteId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Demo",
      "description": "The Demo module: notes, for trying a module's APIs. Needs note.* permissions; scoped by who wrote each note.",
      "item": [
        {
          "name": "Sign in as a super admin for Demo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{webOrigin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{password}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('demoToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{demoToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/demo/notes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "demo",
                "notes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Try the Demo module\",\n  \"body\": \"Written from Postman.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('demoNoteId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List notes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{demoToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/demo/notes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "demo",
                "notes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('lists the new note', () => pm.expect(pm.response.json().notes.map((note) => note.id)).to.include(pm.collectionVariables.get('demoNoteId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get a note",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{demoToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/demo/notes/{{demoNoteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "demo",
                "notes",
                "{{demoNoteId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('is the note', () => pm.expect(pm.response.json().title).to.eql('Try the Demo module'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark a note done",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{demoToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/demo/notes/{{demoNoteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "demo",
                "notes",
                "{{demoNoteId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"done\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('is done', () => pm.expect(pm.response.json().status).to.eql('done'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete a note",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{demoToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/demo/notes/{{demoNoteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "demo",
                "notes",
                "{{demoNoteId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('is deleted', () => pm.expect(pm.response.json().deleted).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
