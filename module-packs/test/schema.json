{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TwinTrack Test API",
  "description": "What the Test API returns. Read with DATA_MODEL.md.",
  "$defs": {
    "Scope": {
      "type": "string",
      "enum": [
        "own",
        "team",
        "all"
      ]
    },
    "Id": {
      "type": "string",
      "minLength": 1
    },
    "DateTime": {
      "type": "string",
      "format": "date-time"
    },
    "TestStatus": {
      "type": "string",
      "enum": [
        "ok"
      ]
    },
    "TestResult": {
      "description": "GET /test",
      "type": "object",
      "required": [
        "status",
        "module",
        "time"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/TestStatus"
        },
        "module": {
          "type": "string",
          "const": "test"
        },
        "time": {
          "$ref": "#/$defs/DateTime"
        }
      }
    },
    "Colleague": {
      "description": "One active colleague from Master's directory. Super admins are never listed.",
      "type": "object",
      "required": [
        "id",
        "name",
        "email"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "department": {
          "type": "string"
        },
        "team": {
          "type": "string"
        },
        "employeeNumber": {
          "type": "integer"
        },
        "photoUpdatedAt": {
          "$ref": "#/$defs/DateTime"
        },
        "online": {
          "type": "boolean",
          "description": "Missing when the viewer's Master presence.read scope doesn't reach this person."
        }
      }
    },
    "ColleagueList": {
      "description": "GET /test/users",
      "type": "object",
      "required": [
        "people",
        "total"
      ],
      "additionalProperties": false,
      "properties": {
        "people": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Colleague"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "How many people match, across every page."
        }
      }
    },
    "ModuleAccess": {
      "description": "GET /me/permissions/test: what the signed-in person may do here.",
      "type": "object",
      "required": [
        "module",
        "hasAccess",
        "permissions",
        "fieldAccess"
      ],
      "properties": {
        "module": {
          "const": "test"
        },
        "hasAccess": {
          "type": "boolean"
        },
        "profileName": {
          "type": [
            "string",
            "null"
          ]
        },
        "permissions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Scope"
          },
          "description": "Such as { \"task.read\": \"team\" }. A missing key means no permission."
        },
        "fieldAccess": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "hidden",
              "read",
              "create",
              "edit"
            ]
          },
          "description": "Keyed resource.field, such as \"task.estimatedHours\"."
        }
      }
    },
    "ApiError": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string",
              "description": "Written for people; show it as is."
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "message"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
