{
  "manifestVersion": 1,
  "module": {
    "key": "test",
    "name": "Test",
    "version": "1.1.0",
    "description": "A small module for checking that a module's routes, permissions and sessions work end to end, and that it can read people from Master.",
    "repository": "twintrack-test",
    "baseUrl": "/test"
  },
  "resources": [
    {
      "key": "test",
      "label": "Test",
      "actions": [
        "read"
      ]
    }
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/",
      "access": "private",
      "permission": "test.read"
    },
    {
      "method": "GET",
      "path": "/users",
      "access": "private",
      "permission": "test.read"
    }
  ]
}
