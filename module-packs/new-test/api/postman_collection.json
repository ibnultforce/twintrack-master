  "item": [
    {
      "name": "New test",
      "description": "The New test module. GET /new-test/health is public. The super admin holds test.read; nobody else does until a profile grants it.",
      "item": [
        {
          "name": "Super admin calls the test route",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/new-test/test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "new-test",
                "test"
              ]
            },
            "description": "Needs test.read in New test. Returns 200 with the module key and server time."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200 with status ok for the new-test module', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ok');",
                  "  pm.expect(body.module).to.eql('new-test');",
                  "  pm.expect(Date.parse(body.time)).to.not.be.NaN;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Someone without test.read is refused",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{noRoleToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/new-test/test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "new-test",
                "test"
              ]
            },
            "description": "Refused with 403 forbidden when the caller's profile doesn't grant test.read."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refuses with 403 forbidden', () => {",
                  "  pm.response.to.have.status(403);",
                  "  pm.expect(pm.response.json().error.code).to.eql('forbidden');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Health check, no token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/new-test/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "new-test",
                "health"
              ]
            },
            "description": "Public. Returns 200 with the module key and server time."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200 with status ok for the new-test module', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ok');",
                  "  pm.expect(body.module).to.eql('new-test');",
                  "  pm.expect(Date.parse(body.time)).to.not.be.NaN;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
