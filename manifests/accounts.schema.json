{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TwinTrack Accounts API",
  "$defs": {
    "Status": {
      "type": "object",
      "required": [
        "module",
        "status",
        "time"
      ],
      "properties": {
        "module": {
          "const": "accounts"
        },
        "status": {
          "const": "ok"
        },
        "time": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "LedgerAccount": {
      "type": "object",
      "description": "One account in the chart of accounts. Never deleted: deactivated instead.",
      "required": [
        "id",
        "code",
        "name",
        "type",
        "normalBalance",
        "isActive",
        "version",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "pattern": "^\\d{3,10}$",
          "description": "Unique across the chart"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "enum": [
            "asset",
            "liability",
            "equity",
            "income",
            "expense"
          ]
        },
        "normalBalance": {
          "enum": [
            "debit",
            "credit"
          ],
          "description": "Worked out from type: debit for assets and expenses"
        },
        "parentId": {
          "type": "string",
          "description": "An active account of the same type"
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "isActive": {
          "type": "boolean"
        },
        "version": {
          "type": "integer"
        },
        "createdBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "bankAccountNumber": {
          "type": "string",
          "description": "Protected field: left out unless the grant names it; masked as \"•••• 7712\" when it does, in the account, lists and history. The full number comes only from POST /accounts/ledger-accounts/:id/reveal-bank-number, which writes the activity log"
        },
        "cashOrBank": {
          "type": "string",
          "enum": [
            "cash",
            "bank"
          ],
          "description": "Set on an asset account that holds money; the Cash and bank screen lists these. Only asset accounts, never one that groups others"
        },
        "bankName": {
          "type": "string",
          "description": "The bank, for a bank account, such as City Bank"
        },
        "balance": {
          "type": "integer",
          "description": "Paisa, from ledger lines only, on the account's normal side: debits minus credits for assets and expenses, credits minus debits for the rest"
        }
      }
    },
    "AccountsSettings": {
      "type": "object",
      "description": "One settings record for the whole module. Each part is a field a profile can hide; a hidden part is left out.",
      "required": [
        "version"
      ],
      "properties": {
        "standInApprover": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "May approve without the approve permission, never their own records"
        },
        "standInUntil": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Last day the stand-in may approve; none means no end"
        },
        "isStandInActive": {
          "type": "boolean"
        },
        "homeCurrency": {
          "const": "BDT",
          "description": "The currency the books are kept in; every ledger amount is in it"
        },
        "currencies": {
          "type": "array",
          "description": "Foreign currencies the company deals in, by code. Exchange rates name only these",
          "items": {
            "type": "object",
            "required": [
              "code",
              "name"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z]{3,10}$",
                "description": "ISO 4217 code such as USD, or a longer one such as USDT; never BDT"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          }
        },
        "defaultCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3,10}$",
          "description": "The currency new documents such as invoices and bills start in: BDT or one of the currencies. People can pick another per document. BDT when never set"
        },
        "exchangeRates": {
          "type": "array",
          "description": "Rates for currencies other than taka, by currency then newest first",
          "items": {
            "type": "object",
            "required": [
              "currency",
              "effectiveFrom",
              "paisaPerUnit"
            ],
            "properties": {
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3,10}$",
                "description": "The code of one of the currencies"
              },
              "effectiveFrom": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "paisaPerUnit": {
                "type": "integer",
                "minimum": 1,
                "description": "Taka per unit in paisa: USD 12250 is 122.50"
              }
            }
          }
        },
        "taxRates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "name",
              "basisPoints"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z0-9_]{1,20}$"
              },
              "name": {
                "type": "string"
              },
              "basisPoints": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000,
                "description": "1500 is 15%"
              }
            }
          }
        },
        "version": {
          "type": "integer"
        },
        "updatedBy": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "JournalVoucher": {
      "type": "object",
      "description": "A voucher a second person approves before it reaches the ledger: a journal voucher (any balanced lines), a payment out of one cash or bank account, or a receipt into one.",
      "required": [
        "id",
        "voucherType",
        "number",
        "voucherDate",
        "memo",
        "lines",
        "total",
        "status",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "voucherType": {
          "enum": [
            "journal",
            "payment",
            "receipt"
          ],
          "description": "Vouchers saved before payment and receipt vouchers existed are journal"
        },
        "number": {
          "type": "string",
          "pattern": "^(JV|PV|RV)-\\d{4,}$",
          "description": "One series per type: JV, PV, RV"
        },
        "voucherDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "memo": {
          "type": "string"
        },
        "party": {
          "type": "string",
          "description": "Who was paid, or who paid. Required on payment and receipt vouchers"
        },
        "reference": {
          "type": "string",
          "description": "The outside document, such as a cheque or bill number"
        },
        "moneyAccountId": {
          "type": "string",
          "description": "Payment and receipt vouchers only: the cash or bank account the money moved through"
        },
        "lines": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "accountId",
              "debit",
              "credit"
            ],
            "properties": {
              "accountId": {
                "type": "string"
              },
              "debit": {
                "type": "integer",
                "minimum": 0,
                "description": "Whole paisa or cents"
              },
              "credit": {
                "type": "integer",
                "minimum": 0,
                "description": "Whole paisa or cents"
              },
              "memo": {
                "type": "string"
              }
            }
          },
          "description": "The full balanced lines, including the cash or bank line that the API adds to a payment or receipt"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Whole paisa or cents"
        },
        "status": {
          "enum": [
            "draft",
            "submitted",
            "recorded",
            "reversed"
          ]
        },
        "returnNote": {
          "type": "string",
          "description": "Why an approver sent it back; cleared on the next submit"
        },
        "createdBy": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "submittedBy": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "approvedBy": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "reversedBy": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reversedAt": {
          "type": "string",
          "format": "date-time"
        },
        "ledgerEntryId": {
          "type": "string"
        },
        "reversalEntryId": {
          "type": "string"
        },
        "allowedActions": {
          "type": "object",
          "description": "Only on GET /journal-vouchers/:id: which actions will work for the caller",
          "properties": {
            "edit": {
              "type": "boolean"
            },
            "submit": {
              "type": "boolean"
            },
            "approve": {
              "type": "boolean"
            },
            "return": {
              "type": "boolean"
            },
            "reverse": {
              "type": "boolean"
            }
          }
        },
        "version": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "waitingUpdateRequest": {
          "type": "object",
          "description": "On a single recorded voucher: the update request waiting to correct it",
          "properties": {
            "id": {
              "type": "string"
            },
            "number": {
              "type": "string"
            }
          }
        },
        "linkedDocument": {
          "type": "object",
          "description": "The invoice or bill a receipt or payment settles. Such a voucher is never edited or corrected by an update request.",
          "required": [
            "type",
            "id",
            "number",
            "amount"
          ],
          "properties": {
            "type": {
              "enum": [
                "invoice",
                "bill",
                "payrollRun",
                "depreciation"
              ]
            },
            "id": {
              "type": "string"
            },
            "number": {
              "type": "string"
            },
            "amount": {
              "type": "integer",
              "minimum": 0,
              "description": "Minor units of the document currency"
            }
          }
        }
      }
    },
    "AuditEntry": {
      "type": "object",
      "description": "One line of the Accounts activity log.",
      "required": [
        "id",
        "at",
        "action",
        "module"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "actorId": {
          "type": "string"
        },
        "actorName": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "description": "Such as journalVoucher.approved or ledgerEntry.posted"
        },
        "targetType": {
          "type": "string"
        },
        "targetId": {
          "type": "string"
        },
        "targetName": {
          "type": "string"
        },
        "module": {
          "const": "accounts"
        }
      }
    },
    "UpdateRequest": {
      "type": "object",
      "description": "A request to correct a recorded journal voucher. Applying it reverses the voucher's ledger entry and records the corrected one; someone other than the requester approves it.",
      "required": [
        "id",
        "number",
        "recordType",
        "recordId",
        "recordNumber",
        "reason",
        "before",
        "after",
        "status",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "number": {
          "type": "string",
          "description": "UR-0001 and so on"
        },
        "recordType": {
          "type": "string",
          "enum": [
            "journalVoucher"
          ]
        },
        "recordId": {
          "type": "string"
        },
        "recordNumber": {
          "type": "string",
          "description": "The voucher number, such as JV-0004"
        },
        "reason": {
          "type": "string"
        },
        "before": {
          "type": "object",
          "required": [
            "voucherDate",
            "memo",
            "lines",
            "total"
          ],
          "properties": {
            "voucherDate": {
              "type": "string",
              "format": "date"
            },
            "memo": {
              "type": "string"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "accountId": {
                    "type": "string"
                  },
                  "debit": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "credit": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "memo": {
                    "type": "string"
                  }
                }
              }
            },
            "total": {
              "type": "integer",
              "description": "Paisa: the sum of the debits, which equals the sum of the credits"
            }
          },
          "description": "The voucher when the request was made"
        },
        "after": {
          "type": "object",
          "required": [
            "voucherDate",
            "memo",
            "lines",
            "total"
          ],
          "properties": {
            "voucherDate": {
              "type": "string",
              "format": "date"
            },
            "memo": {
              "type": "string"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "accountId": {
                    "type": "string"
                  },
                  "debit": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "credit": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "memo": {
                    "type": "string"
                  }
                }
              }
            },
            "total": {
              "type": "integer",
              "description": "Paisa: the sum of the debits, which equals the sum of the credits"
            }
          },
          "description": "The voucher once the request is applied"
        },
        "status": {
          "type": "string",
          "enum": [
            "waiting",
            "applied",
            "rejected"
          ]
        },
        "createdBy": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "decidedBy": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "decidedAt": {
          "type": "string",
          "format": "date-time"
        },
        "rejectionNote": {
          "type": "string"
        },
        "reversalEntryId": {
          "type": "string"
        },
        "correctedEntryId": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      }
    },
    "ClientAccount": {
      "type": "object",
      "description": "How Accounts bills one Master client. Defaults until set: Net 30, the Settings default currency, no rate.",
      "required": [
        "clientId",
        "clientName",
        "termsDays",
        "currency",
        "version"
      ],
      "properties": {
        "clientId": {
          "type": "string"
        },
        "clientName": {
          "type": "string"
        },
        "termsDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 365
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3,10}$"
        },
        "hourlyRate": {
          "type": "integer",
          "minimum": 1,
          "description": "Minor units of the currency per hour of task estimate"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Invoice": {
      "type": "object",
      "description": "Money a client owes, in its own currency. Issued invoices are recorded in taka at the rate on the issue date.",
      "required": [
        "id",
        "number",
        "clientId",
        "clientName",
        "currency",
        "issueDate",
        "dueDate",
        "lines",
        "total",
        "status",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "number": {
          "type": "string",
          "pattern": "^INV-\\d{4,}$"
        },
        "clientId": {
          "type": "string"
        },
        "clientName": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3,10}$"
        },
        "issueDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "dueDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "description",
              "amount"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "amount": {
                "type": "integer",
                "minimum": 0,
                "description": "Minor units of the invoice currency"
              },
              "taskId": {
                "type": "string"
              },
              "hours": {
                "type": "number",
                "minimum": 0
              },
              "milestone": {
                "type": "string"
              }
            }
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Minor units of the invoice currency"
        },
        "exchangeRate": {
          "type": "integer",
          "minimum": 1,
          "description": "Paisa per unit on the issue date; set when issued"
        },
        "totalInTaka": {
          "type": "integer",
          "minimum": 0,
          "description": "Paisa; set when issued"
        },
        "status": {
          "enum": [
            "draft",
            "submitted",
            "issued",
            "cancelled"
          ]
        },
        "paid": {
          "type": "integer",
          "minimum": 0,
          "description": "Settled by recorded vouchers linked to it, in its currency"
        },
        "outstanding": {
          "type": "integer",
          "minimum": 0,
          "description": "Still owed"
        },
        "pending": {
          "type": "integer",
          "minimum": 0,
          "description": "Settled by linked vouchers still in draft or waiting for approval"
        },
        "paymentStatus": {
          "enum": [
            "unpaid",
            "part_paid",
            "paid",
            "overdue"
          ],
          "description": "Only on an issued invoice or recorded bill"
        },
        "daysOverdue": {
          "type": "integer",
          "minimum": 1
        },
        "returnNote": {
          "type": "string"
        },
        "createdBy": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "submittedBy": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "approvedBy": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "cancelledBy": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "cancelledAt": {
          "type": "string",
          "format": "date-time"
        },
        "ledgerEntryId": {
          "type": "string"
        },
        "reversalEntryId": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Vendor": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "tdsBasisPoints",
        "isActive",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "enum": [
            "rent",
            "cloud",
            "utilities",
            "equipment",
            "food_and_events",
            "other"
          ]
        },
        "tdsBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "description": "500 is 5%"
        },
        "contactEmail": {
          "type": "string"
        },
        "contactPhone": {
          "type": "string"
        },
        "isActive": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Bill": {
      "type": "object",
      "description": "Money owed to a vendor, in taka. TDS is the vendor rate on the total; the vendor is owed the rest.",
      "required": [
        "id",
        "number",
        "vendorId",
        "vendorName",
        "billDate",
        "dueDate",
        "lines",
        "amount",
        "tdsBasisPoints",
        "tds",
        "netPayable",
        "status",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "number": {
          "type": "string",
