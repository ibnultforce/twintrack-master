{
  "manifestVersion": 1,
  "module": {
    "key": "accounts",
    "name": "Accounts",
    "version": "1.12.0",
    "description": "Ledger, vouchers, bills, invoices, payroll and reports. Built so far: settings, the chart of accounts, journal, payment and receipt vouchers with approval, the approvals queue, cash and bank balances, update requests that correct recorded vouchers, change history, client billing, invoices with receipts, vendors, bills with payments, and the Accounts activity log.",
    "repository": "twintrack-accounts",
    "baseUrl": "/accounts"
  },
  "resources": [
    {
      "key": "setting",
      "label": "Accounts settings",
      "actions": [
        "read",
        "update"
      ],
      "scoped": false,
      "trackedFields": [
        "standInApproverId",
        "standInUntil",
        "currencies",
        "defaultCurrency",
        "exchangeRates",
        "taxRates"
      ],
      "recordFields": [
        "standInApproverId",
        "standInUntil",
        "currencies",
        "defaultCurrency",
        "exchangeRates",
        "taxRates"
      ]
    },
    {
      "key": "ledgerAccount",
      "label": "Chart of accounts",
      "actions": [
        "read",
        "create",
        "update"
      ],
      "scoped": false,
      "trackedFields": [
        "code",
        "name",
        "type",
        "parentId",
        "isActive",
        "bankAccountNumber",
        "cashOrBank",
        "bankName"
      ],
      "recordFields": [
        "code",
        "name",
        "type",
        "parentId",
        "description",
        "isActive",
        "bankAccountNumber",
        "cashOrBank",
        "bankName"
      ],
      "protectedFields": [
        "bankAccountNumber"
      ]
    },
    {
      "key": "journalVoucher",
      "label": "Vouchers (journal, payment, receipt)",
      "actions": [
        "read",
        "create",
        "update",
        "approve"
      ],
      "scoped": false,
      "trackedFields": [
        "voucherDate",
        "memo",
        "party",
        "reference",
        "moneyAccountId",
        "lines",
        "total",
        "status",
        "returnNote"
      ],
      "recordFields": [
        "voucherDate",
        "memo",
        "party",
        "reference",
        "moneyAccountId",
        "lines",
        "linkedDocument"
      ]
    },
    {
      "key": "updateRequest",
      "label": "Update requests",
      "actions": [
        "read",
        "create",
        "approve"
      ],
      "scoped": false,
      "trackedFields": [
        "status",
        "rejectionNote"
      ],
      "recordFields": [
        "recordType",
        "recordId",
        "reason",
        "after"
      ]
    },
    {
      "key": "auditLog",
      "label": "Accounts activity log",
      "actions": [
        "read"
      ],
      "scoped": false
    },
    {
      "key": "clientAccount",
      "label": "Client billing",
      "actions": [
        "read",
        "update"
      ],
      "scoped": false,
      "trackedFields": [
        "termsDays",
        "currency",
        "hourlyRate"
      ],
      "recordFields": [
        "termsDays",
        "currency",
        "hourlyRate"
      ]
    },
    {
      "key": "invoice",
      "label": "Invoices",
      "actions": [
        "read",
        "create",
        "update",
        "approve"
      ],
      "scoped": false,
      "trackedFields": [
        "clientId",
        "currency",
        "issueDate",
        "dueDate",
        "lines",
        "total",
        "exchangeRate",
        "totalInTaka",
        "status",
        "returnNote"
      ],
      "recordFields": [
        "clientId",
        "currency",
        "issueDate",
        "dueDate",
        "lines",
        "total",
        "exchangeRate",
        "totalInTaka"
      ]
    },
    {
      "key": "vendor",
      "label": "Vendors",
      "actions": [
        "read",
        "create",
        "update"
      ],
      "scoped": false,
      "trackedFields": [
        "name",
        "category",
        "tdsBasisPoints",
        "contactEmail",
        "contactPhone",
        "isActive"
      ],
      "recordFields": [
        "name",
        "category",
        "tdsBasisPoints",
        "contactEmail",
        "contactPhone",
        "isActive"
      ]
    },
    {
      "key": "bill",
      "label": "Bills",
      "actions": [
        "read",
        "create",
        "update",
        "approve"
      ],
      "scoped": false,
      "trackedFields": [
        "vendorId",
        "vendorReference",
        "billDate",
        "dueDate",
        "lines",
        "amount",
        "tds",
        "netPayable",
        "status",
        "returnNote"
      ],
      "recordFields": [
        "vendorId",
        "vendorReference",
        "billDate",
        "dueDate",
        "lines",
        "amount",
        "tdsBasisPoints",
        "tds",
        "netPayable"
      ]
    }
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/status",
      "access": "private",
      "permission": "setting.read"
    },
    {
      "method": "GET",
      "path": "/ledger-accounts",
      "access": "private",
      "permission": "ledgerAccount.read"
    },
    {
      "method": "POST",
      "path": "/ledger-accounts",
      "access": "private",
      "permission": "ledgerAccount.create"
    },
    {
      "method": "GET",
      "path": "/ledger-accounts/:id",
      "access": "private",
      "permission": "ledgerAccount.read"
    },
    {
      "method": "PATCH",
      "path": "/ledger-accounts/:id",
      "access": "private",
      "permission": "ledgerAccount.update"
    },
    {
      "method": "GET",
      "path": "/settings",
      "access": "private",
      "permission": "setting.read"
    },
    {
      "method": "PATCH",
      "path": "/settings",
      "access": "private",
      "permission": "setting.update"
    },
    {
      "method": "GET",
      "path": "/settings/approver-candidates",
      "access": "private",
      "permission": "setting.update"
    },
    {
      "method": "GET",
      "path": "/ledger-accounts/:id/history",
      "access": "private",
      "permission": "ledgerAccount.read"
    },
    {
      "method": "POST",
      "path": "/ledger-accounts/:id/reveal-bank-number",
      "access": "private",
      "permission": "ledgerAccount.read"
    },
    {
      "method": "GET",
      "path": "/journal-vouchers",
      "access": "private",
      "permission": "journalVoucher.read"
    },
    {
      "method": "POST",
      "path": "/journal-vouchers",
      "access": "private",
      "permission": "journalVoucher.create"
    },
    {
      "method": "GET",
      "path": "/journal-vouchers/:id",
      "access": "private",
      "permission": "journalVoucher.read"
    },
    {
      "method": "PATCH",
      "path": "/journal-vouchers/:id",
      "access": "private",
      "permission": "journalVoucher.update"
    },
    {
      "method": "POST",
      "path": "/payment-vouchers",
      "access": "private",
      "permission": "journalVoucher.create"
    },
    {
      "method": "PATCH",
      "path": "/payment-vouchers/:id",
      "access": "private",
      "permission": "journalVoucher.update"
    },
    {
      "method": "POST",
      "path": "/receipt-vouchers",
      "access": "private",
      "permission": "journalVoucher.create"
    },
    {
      "method": "PATCH",
      "path": "/receipt-vouchers/:id",
      "access": "private",
      "permission": "journalVoucher.update"
    },
    {
      "method": "POST",
      "path": "/journal-vouchers/:id/submit",
      "access": "private",
      "permission": "journalVoucher.update"
    },
    {
      "method": "POST",
      "path": "/journal-vouchers/:id/approve",
      "access": "private",
      "permission": "journalVoucher.read"
    },
    {
      "method": "POST",
      "path": "/journal-vouchers/:id/return",
      "access": "private",
      "permission": "journalVoucher.read"
    },
    {
      "method": "POST",
      "path": "/journal-vouchers/:id/reverse",
      "access": "private",
      "permission": "journalVoucher.read"
    },
    {
      "method": "GET",
      "path": "/journal-vouchers/:id/history",
      "access": "private",
      "permission": "journalVoucher.read"
    },
    {
      "method": "GET",
      "path": "/cash-bank",
      "access": "private",
      "permission": "ledgerAccount.read"
    },
    {
      "method": "GET",
      "path": "/update-requests",
      "access": "private",
      "permission": "updateRequest.read"
    },
    {
      "method": "POST",
      "path": "/update-requests",
      "access": "private",
      "permission": "updateRequest.create"
    },
    {
      "method": "GET",
      "path": "/update-requests/:id",
      "access": "private",
      "permission": "updateRequest.read"
    },
    {
      "method": "POST",
      "path": "/update-requests/:id/approve",
      "access": "private",
      "permission": "updateRequest.read"
    },
    {
      "method": "POST",
      "path": "/update-requests/:id/reject",
      "access": "private",
      "permission": "updateRequest.read"
    },
    {
      "method": "GET",
      "path": "/change-history",
      "access": "private",
      "anyPermission": [
        "journalVoucher.read",
        "updateRequest.read"
      ]
    },
    {
      "method": "GET",
      "path": "/approvals",
      "access": "private",
      "anyPermission": [
        "journalVoucher.read",
        "invoice.read",
        "bill.read",
        "updateRequest.read"
      ]
    },
    {
      "method": "GET",
      "path": "/audit-log",
      "access": "private",
      "permission": "auditLog.read"
    },
    {
      "method": "GET",
      "path": "/clients",
      "access": "private",
      "permission": "clientAccount.read"
    },
    {
      "method": "PATCH",
      "path": "/clients/:id",
      "access": "private",
      "permission": "clientAccount.update"
    },
    {
      "method": "GET",
      "path": "/invoices",
      "access": "private",
      "permission": "invoice.read"
    },
    {
      "method": "POST",
      "path": "/invoices",
      "access": "private",
      "permission": "invoice.create"
    },
    {
      "method": "GET",
      "path": "/invoices/billable-tasks",
      "access": "private",
      "permission": "invoice.create"
    },
    {
      "method": "GET",
      "path": "/invoices/:id",
      "access": "private",
      "permission": "invoice.read"
    },
    {
      "method": "PATCH",
      "path": "/invoices/:id",
      "access": "private",
      "permission": "invoice.update"
    },
    {
      "method": "POST",
      "path": "/invoices/:id/submit",
      "access": "private",
      "permission": "invoice.update"
    },
    {
      "method": "POST",
      "path": "/invoices/:id/approve",
      "access": "private",
      "permission": "invoice.read"
    },
    {
      "method": "POST",
      "path": "/invoices/:id/return",
      "access": "private",
      "permission": "invoice.read"
    },
    {
      "method": "POST",
      "path": "/invoices/:id/cancel",
      "access": "private",
      "permission": "invoice.read"
    },
    {
      "method": "POST",
      "path": "/invoices/:id/receive-payment",
      "access": "private",
      "permission": "journalVoucher.create"
    },
    {
      "method": "GET",
      "path": "/invoices/:id/history",
      "access": "private",
      "permission": "invoice.read"
    },
    {
      "method": "GET",
      "path": "/vendors",
      "access": "private",
      "permission": "vendor.read"
    },
    {
      "method": "POST",
      "path": "/vendors",
      "access": "private",
      "permission": "vendor.create"
    },
    {
      "method": "GET",
      "path": "/vendors/:id",
      "access": "private",
      "permission": "vendor.read"
    },
    {
      "method": "PATCH",
      "path": "/vendors/:id",
      "access": "private",
      "permission": "vendor.update"
    },
    {
      "method": "GET",
      "path": "/vendors/:id/history",
      "access": "private",
      "permission": "vendor.read"
    },
    {
      "method": "GET",
      "path": "/bills",
      "access": "private",
      "permission": "bill.read"
    },
    {
      "method": "POST",
      "path": "/bills",
      "access": "private",
      "permission": "bill.create"
    },
    {
      "method": "GET",
      "path": "/bills/:id",
      "access": "private",
      "permission": "bill.read"
    },
    {
      "method": "PATCH",
      "path": "/bills/:id",
      "access": "private",
      "permission": "bill.update"
    },
    {
      "method": "POST",
      "path": "/bills/:id/submit",
      "access": "private",
      "permission": "bill.update"
    },
    {
      "method": "POST",
      "path": "/bills/:id/approve",
      "access": "private",
      "permission": "bill.read"
    },
    {
      "method": "POST",
      "path": "/bills/:id/return",
      "access": "private",
      "permission": "bill.read"
    },
    {
      "method": "POST",
      "path": "/bills/:id/cancel",
      "access": "private",
      "permission": "bill.read"
    },
    {
      "method": "POST",
      "path": "/bills/:id/pay",
      "access": "private",
      "permission": "journalVoucher.create"
    },
    {
      "method": "GET",
      "path": "/bills/:id/history",
      "access": "private",
      "permission": "bill.read"
    }
  ]
}
