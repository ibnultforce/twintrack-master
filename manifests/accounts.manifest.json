{
  "manifestVersion": 1,
  "module": {
    "key": "accounts",
    "name": "Accounts",
    "version": "1.1.0",
    "description": "Ledger, vouchers, bills, invoices, payroll and reports. Built so far: a status check and the chart of accounts.",
    "repository": "twintrack-accounts",
    "baseUrl": "/accounts"
  },
  "resources": [
    {
      "key": "setting",
      "label": "Accounts settings",
      "actions": [
        "read"
      ],
      "scoped": false
    },
    {
      "key": "ledgerAccount",
      "label": "Chart of accounts",
      "actions": [
        "read",
        "create",
        "update"
      ],
      "scoped": false,
      "trackedFields": [
        "code",
        "name",
        "type",
        "parentId",
        "isActive"
      ],
      "recordFields": [
        "code",
        "name",
        "type",
        "parentId",
        "description",
        "isActive"
      ]
    }
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/status",
      "access": "private",
      "permission": "setting.read"
    },
    {
      "method": "GET",
      "path": "/ledger-accounts",
      "access": "private",
      "permission": "ledgerAccount.read"
    },
    {
      "method": "POST",
      "path": "/ledger-accounts",
      "access": "private",
      "permission": "ledgerAccount.create"
    },
    {
      "method": "GET",
      "path": "/ledger-accounts/:id",
      "access": "private",
      "permission": "ledgerAccount.read"
    },
    {
      "method": "PATCH",
      "path": "/ledger-accounts/:id",
      "access": "private",
      "permission": "ledgerAccount.update"
    }
  ]
}
